*.manifest
*.spec

# Unit test / coverage reports
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
pytest_cache/

# Jupyter notebooks
.ipynb_checkpoints/

